; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but this file is generated by hand as the project skeleton.

config_version=5

[application]

config/name="FlightBench"
config/version="0.1.0"
config/description="A bench for flight-controller firmware developers: the real firmware in an emulated MCU, flown by an FDM."
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DevHooks="*res://scripts/DevHooks.cs"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
; UI scale = root content_scale_factor (Ui.ApplyScale); "disabled" keeps 1 UI unit = factor px, 3D at full res
window/stretch/mode="disabled"

[dotnet]

project/assembly_name="FlightBench"

[rendering]

renderer/rendering_method="forward_plus"
