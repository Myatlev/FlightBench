[gd_scene format=3]

; Trainer visual rig (placeholder): named pivots only; meshes are built in code by TrainerVisual.cs (visual_class).
; Frame: Godot body axes (x right, y up, z back, nose towards -z), origin at the CG; the FDM's ground contact
; is cg_height below it. Surface pivots sit on their hinge lines and carry the actuator names of
; models/trainer/aircraft.json: aileron_l / aileron_r (hinge along x at the wing's rear spar, the surface
; runs back to the trailing edge), elevator (hinge along x at the stabiliser's trailing edge), rudder (hinge
; along y at the fin's trailing edge); prop = the propeller hub (spins about z), motor = the motor can.
; Sign convention (state.plane.surfaces_deg): + = aileron trailing edge down, elevator trailing edge up,
; rudder trailing edge right. view_size = the model's size in metres (span): the cameras scale by it.

[node name="trainer" type="Node3D"]
metadata/visual_class = "FlightBench.Models.TrainerVisual"
metadata/cg_height = 0.1
metadata/view_size = 1.88

