{"id": "trainer", "name": "Trainer (1.9 m electric trainer)", "class": "electric trainer plane", "fdm": "plane",
 "actuators": ["aileron_l", "aileron_r", "elevator", "rudder", "motor"],
 "fdm_inputs": ["aileron_l", "aileron_r", "elevator", "rudder"],
 "centre_us": {"aileron_l": 1500, "aileron_r": 1500, "elevator": 1500, "rudder": 1500},
 "throttle": "motor",
 "esc": {"kv": 1000, "poles": 14, "tau_s": 0.05, "max_current_a": 60, "idle_current_a": 0.3, "voltage_v": 14.8},
 "firmware_cli": "models/trainer/inav.cli",
 "env_default": "env/launch.json",
 "functions": [
  {"name": "calibrate_acc", "label": "Calibrate accelerometer (6 positions)", "auto_first_start": true,
   "scenario": "env/acc-calibration.json", "params": {}},
  {"name": "calibrate_mag", "label": "Calibrate compass (turn the model through the field)", "auto_first_start": true,
   "params": {}},
  {"name": "calibrate_gyro", "label": "Calibrate gyro (hold level and still, reboot)", "auto_first_start": false,
   "params": {"hold_s": 2}},
  {"name": "launch", "label": "Hand launch", "auto_first_start": false,
   "params": {"speed_kmh": 50, "duration_s": 0.5, "pitch_deg": 10}}],
 "env": ["env/launch.json", "env/ground-takeoff.json", "env/acc-calibration.json"],
 "fdm_params": {
  "mass_kg": 2.0,
  "inertia_kgm2": [0.12, 0.09, 0.19],
  "wing": {"area_m2": 0.45, "span_m": 1.88, "chord_m": 0.24},
  "aero": {"lift0": 0.30, "lift_alpha": 5.0, "lift_q": 3.0, "lift_elevator": -0.20,
           "alpha_stall_deg": 15, "stall_sharpness": 40,
           "drag0": 0.045, "drag_elevator": 0.02, "oswald": 0.85,
           "side_beta": -0.6, "side_p": 0, "side_r": 0, "side_aileron": 0, "side_rudder": -0.15,
           "roll_beta": -0.08, "roll_p": -0.45, "roll_r": 0.12, "roll_aileron": 0.18, "roll_rudder": 0.01,
           "pitch0": 0.04, "pitch_alpha": -0.8, "pitch_q": -12, "pitch_elevator": 1.1,
           "yaw_beta": 0.09, "yaw_p": -0.03, "yaw_r": -0.12, "yaw_aileron": -0.01, "yaw_rudder": 0.07},
  "cp_offset_m": [-0.02, 0, -0.04],
  "prop": {"diameter_in": 11, "pitch_in": 7, "ct": 0.10},
  "thrust_offset_m": [0.3, 0, 0],
  "rpm_max": 14800,
  "surface_deflection_deg": 20,
  "servo": {"delay_ms": 10, "speed_s60": 0.1, "centre_us": 1500, "travel_us": 500},
  "ground_friction": 0.3, "gear_height_m": 0.1, "gear_arm_m": 0.06}}
