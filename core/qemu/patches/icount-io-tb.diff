+/*
+ * icount: an instruction that does device I/O must be the last one of its TB
+ * (can_do_io). Found in the middle of one, cpu_io_recompile() rewinds to it and
+ * runs it as a TB of one instruction, then goes on with a new TB after it -- at
+ * every execution, since the cached TB stays as it was: a host-PC unwind, a TB
+ * lookup and a longjmp per access (a polling loop on a device register pays it
+ * on every pass). Noted here, the instruction gets that one-instruction TB from
+ * the translator instead: the same TB boundaries, hence the same instruction
+ * counts, interrupt checks and guest state at the access, without the
+ * round trip. Used by the vCPU thread only (icount runs one vCPU thread).
+ */
+bool icount_io_insn_tbs;
+static GHashTable *tb_io_insns;
+
+void tb_io_insn_note(vaddr pc)
+{
+    if (!tb_io_insns) {
+        tb_io_insns = g_hash_table_new(g_direct_hash, g_direct_equal);
+    }
+    g_hash_table_add(tb_io_insns, (gpointer)(uintptr_t)pc);
+}
+
+bool tb_io_insn_ends_tb(vaddr pc, vaddr next_pc)
+{
+    return tb_io_insns &&
+           (g_hash_table_contains(tb_io_insns, (gpointer)(uintptr_t)pc) ||
+            g_hash_table_contains(tb_io_insns, (gpointer)(uintptr_t)next_pc));
+}
+
+void tb_io_insn_forget_all(void)
+{
+    if (tb_io_insns) {
+        g_hash_table_remove_all(tb_io_insns);
+    }
+}
