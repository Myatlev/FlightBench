+/*
+ * icount: cpu_io_recompile() runs at every execution of a TB with a device
+ * access in its middle -- in a polling loop, at every pass. Its TB search by
+ * host PC and the unwind-data decode give the same answer each time until the
+ * code buffer is flushed (host code is not reused before that), so both are
+ * memoized per host PC. The restore itself is unchanged. icount runs one vCPU
+ * thread: no locking.
+ */
+typedef struct IoRecompileMemo {
+    uintptr_t retaddr;
+    TranslationBlock *tb;
+    unsigned flush_count;
+    int insns_left;
+    uint64_t data[INSN_START_WORDS];
+} IoRecompileMemo;
+
+static IoRecompileMemo io_recompile_memo[256];
+
+static TranslationBlock *io_recompile_restore(CPUState *cpu, uintptr_t retaddr)
+{
+    IoRecompileMemo *m = &io_recompile_memo[(retaddr >> 2) & 255];
+    unsigned flush_count = qatomic_read(&tb_ctx.tb_flush_count);
+    TranslationBlock *tb;
+
+    if (m->tb && m->retaddr == retaddr && m->flush_count == flush_count) {
+        tb = m->tb;
+    } else {
+        tb = tcg_tb_lookup(retaddr);
+        if (!tb) {
+            cpu_abort(cpu, "cpu_io_recompile: could not find TB for pc=%p",
+                      (void *)retaddr);
+        }
+        if (!(tb_cflags(tb) & CF_USE_ICOUNT)) {
+            cpu_restore_state_from_tb(cpu, tb, retaddr);
+            return tb;
+        }
+        m->insns_left = cpu_unwind_data_from_tb(tb, retaddr, m->data);
+        m->retaddr = retaddr;
+        m->tb = tb;
+        m->flush_count = flush_count;
+    }
+    /* what cpu_restore_state_from_tb() does with the unwind data */
+    if (m->insns_left >= 0) {
+        cpu->neg.icount_decr.u16.low += m->insns_left;
+        cpu->cc->tcg_ops->restore_state_to_opc(cpu, tb, m->data);
+    }
+    return tb;
+}
