+void qemu_clock_notify_nonempty(QEMUClockType type)
+{
+    QEMUTimerList *timer_list;
+    QEMUClock *clock = qemu_clock_ptr(type);
+    QLIST_FOREACH(timer_list, &clock->timerlists, list) {
+        /* FlightBench: an AioContext list without timers has nothing to run */
+        if (timer_list == main_loop_tlg.tl[type] || timerlist_has_timers(timer_list)) {
+            timerlist_notify(timer_list);
+        }
+    }
+}
