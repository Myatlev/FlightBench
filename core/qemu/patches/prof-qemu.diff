diff --git a/include/qemu/prof-hooks.h b/include/qemu/prof-hooks.h
new file mode 100644
index 0000000..b61777c
--- /dev/null
+++ b/include/qemu/prof-hooks.h
@@ -0,0 +1,44 @@
+/*
+ * Host-time profiling hooks (FlightBench core/qemu/patches/prof-qemu.diff).
+ *
+ * A machine that wants to see where host time goes installs a table of callbacks here; with no
+ * table installed (the default) every hook site costs one load and one untaken branch. The hooks
+ * only observe: none of them may change what the vCPU executes or when.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef QEMU_PROF_HOOKS_H
+#define QEMU_PROF_HOOKS_H
+
+#include "qemu/atomic.h"
+
+typedef struct QemuProfHooks {
+    /* vCPU thread (single-threaded TCG round robin), around tcg_cpu_exec(); BQL not held */
+    void (*slice_start)(CPUState *cpu);
+    /* after icount_process_data(); left = instructions of the budget not executed */
+    void (*slice_end)(CPUState *cpu, int ret, int64_t left);
+    /* the vCPU thread sleeps on halt_cond (all vCPUs idle) / wakes up; BQL released inside */
+    void (*vcpu_wait)(bool begin);
+    /* qemu_cpu_kick(): self = called on the vCPU's own thread (cpu_exit from inside) */
+    void (*kick)(CPUState *cpu, bool self);
+    /* qemu_timer_notify_cb() on the vCPU thread: a virtual timer was armed earlier than the
+     * running budget, the vCPU leaves cpu_exec to recompute it */
+    void (*timer_exit)(void);
+    /* aio_notify() wrote the event notifier (a thread in poll must wake up) */
+    void (*notify)(void);
+    /* main loop: around qemu_poll_ns() in os_host_main_loop_wait(); BQL not held */
+    void (*poll)(bool begin, unsigned nfds);
+    /* bql_lock() found the BQL taken: begin before blocking, end once it is held */
+    void (*bql_wait)(bool begin);
+} QemuProfHooks;
+
+extern const QemuProfHooks *qemu_prof_hooks;
+
+#define QEMU_PROF_HOOK(fn, ...) do {                                    \
+        const QemuProfHooks *h_ = qatomic_read(&qemu_prof_hooks);       \
+        if (unlikely(h_ != NULL) && h_->fn) {                           \
+            h_->fn(__VA_ARGS__);                                        \
+        }                                                               \
+    } while (0)
+
+#endif
