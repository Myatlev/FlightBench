{
  "name": "Trainer · FPV with OSD",
  "description": "The Trainer · NAV LAUNCH bench (SpeedyBee F405 WING, stock iNav 9.1.0, CRSF on uart1, ESC on S1, servos S3..S6, the GPS module on uart3 + I2C1 with its compass, the onboard SPL06 baro, a 4S battery) plus a digital HD VTX OSD: `msp_osd` (MSP DisplayPort) on UART4, the free UART next to the GPS; OSD window, FPV camera with the OSD overlay. First start and flying as the NAV LAUNCH preset: ANGLE (ch6, key 6) + NAV LAUNCH (ch7, key 7) on, ARM (ch5, key 5) with the throttle low, throttle up (W), Launch (L).",
  "board": "speedybee-f405-wing",
  "firmwarePath": "firmware/speedybee-f405-wing/inav_9.1.0_SPEEDYBEEF405WING.hex",
  "watchFirmware": false,
  "aircraft": "trainer",
  "visual": "models/trainer/visual/trainer.tscn",
  "switches": [
    {
      "channel": 5,
      "name": "ARM",
      "note": "high (1700..2100) = armed; arm with the throttle low"
    },
    {
      "channel": 6,
      "name": "ANGLE",
      "note": "high = ANGLE (self-level); needed for NAV LAUNCH"
    },
    {
      "channel": 7,
      "name": "NAV LAUNCH",
      "note": "high = launch mode; turn it on while disarmed (iNav enters launch mode only from a box switched on before arming)"
    }
  ],
  "switchOrder": "ANGLE + NAV LAUNCH on -> ARM with the throttle low -> throttle up (iNav waits, motor idle) -> Launch",
